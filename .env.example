# Copy to .env.local and fill in. .env.local is git-ignored and takes precedence over everything
# else, so local work can never reach a hosted database by accident.
#
# On Vercel these are set in the project's environment settings, not in a file. A real process
# environment variable always beats a .env file, which is why nothing here needs a live value.

# ── Required to run at all ───────────────────────────────────────────────────
# Postgres. Locally this is a Postgres on your own machine; never point it at the hosted database.
DATABASE_URL=postgres://spec:spec@127.0.0.1:5432/specdemo
# Where the app is served from. Used for links back into SPEC, never for sending content.
APP_URL=http://localhost:3000

# ── Sign-in (Supabase Auth) ──────────────────────────────────────────────────
# The anon key is public by design and ships to the browser. The service role key never does.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_MONTHLY=

# ── The assistant, on Advanced ───────────────────────────────────────────────
# Server-side only. No API key ever reaches the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Email ────────────────────────────────────────────────────────────────────
# Used for exactly two things: a set-password link, and confirming an address the first time
# somebody adds a seat. Nothing with business content in it is ever sent.
RESEND_API_KEY=

# ── Sign-up protection ───────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the hidden field on public forms.
FORM_SECRET=

# ── Operations ───────────────────────────────────────────────────────────────
# Comma-separated addresses allowed to open /admin. Accounts only — never customer data.
ADMIN_EMAILS=
